# Copy to .env and edit. Every value below is the default.
# Broker credentials never go here; they are sent per session via POST /brokers/{broker}/sessions.

# app / logging
APP_ENV=dev                          # shown in /health
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                      # json | text
INSTRUMENTS_PATH=data/instruments.json

# sessions / http
SESSION_TTL_MIN=480                  # minutes before a broker session is evicted
HTTP_TIMEOUT_S=10                    # shared httpx client (connect is fixed at 5 s)
MAX_INFLIGHT_PER_BROKER=4            # concurrent calls per adapter

# execution engine
PLACE_MAX_ATTEMPTS=3                 # attempts per order on 429 / connect errors
RETRY_BASE_DELAY_S=0.25              # exponential backoff with jitter; Retry-After wins
RETRY_MAX_DELAY_S=5.0
POLL_INTERVAL_S=1.0
POLL_TIMEOUT_S=30                    # per phase; open orders past this are TIMED_OUT / PARTIALLY_FILLED
AMBIGUOUS_LOOKUP_ATTEMPTS=5          # tag lookups for an ambiguous order (never resent)
AMBIGUOUS_LOOKUP_INTERVAL_S=2.0
MARKET_HOURS_WARN=true               # warn outside Mon-Fri 09:15-15:30 IST

# notifications / storage
WEBHOOK_URL=http://localhost:8000/mock/webhook   # blank disables
WEBHOOK_TIMEOUT_S=5
RUN_STORE_LIMIT=200                  # reports kept in memory

# paper broker (the Docker default)
PAPER_SEED_HOLDINGS=                 # e.g. INFY:10,TCS:5
PAPER_REJECT_RATE=0                  # P(sync rejection)
PAPER_LATENCY_MS=20-120              # "lo-hi" milliseconds
PAPER_RATE_LIMIT_EVERY_N=0           # every n-th placement gets a 429; 0 = off
PAPER_AMBIGUOUS_RATE=0               # P(timeout after send)
PAPER_AMBIGUOUS_PLACED=true          # was the ambiguous order recorded anyway?
PAPER_PARTIAL_FILL_RATE=0            # P(half fill, then stays open)
PAPER_FILL_AFTER_POLLS=1             # fills on the n-th status read
PAPER_SEED=42                        # RNG seed for reproducible runs

# real broker base URL overrides (blank = production)
ZERODHA_BASE_URL=
FYERS_BASE_URL=
ANGELONE_BASE_URL=
UPSTOX_BASE_URL=
UPSTOX_ORDER_BASE_URL=
GROWW_BASE_URL=
